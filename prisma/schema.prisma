generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum TipoActividad {
  NUEVO_LIBRO
  RADIO_EPISODIO
  FORO_APL
  NUEVA_OPINION
  AVISO
}

// ------------------------------------------------------
// USUARIOS Y ROLES
// ------------------------------------------------------

model rol {
  rol_id     Int       @id @default(autoincrement())
  nombre_rol String    @unique @db.VarChar(50)
  usuario    usuario[]
}

model usuario {
  usuario_id            Int                     @id @default(autoincrement())
  nombre                String                  @db.VarChar(100)
  email                 String                  @unique @db.VarChar(255)
  contrasena            String
  rol_id                Int?
  fecha_registro        DateTime                @default(now()) @db.Timestamptz(6)
  perfil_completo       Boolean                 @default(false)
  avatar_url            String?
  nivel_educativo       String?                 @db.VarChar(50)
  comentario_foro       comentario_foro[]
  exportacion           exportacion[]
  favorito              favorito[]
  foro                  foro[]
  lista_lectura         lista_lectura[]
  opinion               opinion[]
  rol                   rol?                    @relation(fields: [rol_id], references: [rol_id], onDelete: NoAction, onUpdate: NoAction)
  usuario_club_lectura  usuario_club_lectura[]
  usuario_medalla       usuario_medalla[]
  meta_lectura          meta_lectura[]
  actividad_feed        actividad_feed[]
  cafe_literario        cafe_literario[]
  asistencia_cafe       asistencia_cafe[]
  voto_cafe             voto_cafe[]
  incidencia_moderacion incidencia_moderacion[]
  curso_docente         curso_docente[]
  inscripcion           inscripcion[]

  @@index([rol_id])
}

// ------------------------------------------------------
// FEED DE ACTIVIDAD
// ------------------------------------------------------

model actividad_feed {
  actividad_id Int           @id @default(autoincrement())
  usuario_id   Int?
  tipo         TipoActividad
  titulo       String        @db.VarChar(255)
  descripcion  String?       @db.Text
  entidad_id   Int? // ID referencial opcional (libro_id, foro_id, episodio_id)
  fecha        DateTime      @default(now()) @db.Timestamptz(6)

  usuario usuario? @relation(fields: [usuario_id], references: [usuario_id], onDelete: SetNull)

  @@index([fecha(sort: Desc)])
}

// ------------------------------------------------------
// CATÁLOGO Y LIBROS
// ------------------------------------------------------

model libro {
  libro_id              Int     @id @default(autoincrement())
  titulo                String  @db.VarChar(255)
  autor                 String  @db.VarChar(255)
  genero                String? @db.VarChar(100)
  descripcion           String?
  portada_url           String?
  nivel_educativo       String? @db.VarChar(50)
  calificacion_promedio Float?
  activo                Boolean @default(true)
  pagina_actual         Int?    @default(0)
  paginas_totales       Int?    @default(100)

  //Relaciones
  favorito          favorito[]
  lista_libro       lista_libro[]
  opinion           opinion[]
  recurso_educativo recurso_educativo[]
  cafe_literario    cafe_literario[]
  curso_libro       curso_libro[]
}

model favorito {
  usuario_id    Int
  libro_id      Int
  estado_lectura String  @default("general") @db.VarChar(20)
  libro         libro   @relation(fields: [libro_id], references: [libro_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_libro")
  usuario       usuario @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario")

  @@id([usuario_id, libro_id])
}

model opinion {
  opinion_id   Int       @id @default(autoincrement())
  usuario_id   Int
  libro_id     Int
  calificacion Int?      @db.SmallInt
  comentario   String?   @db.Text
  fecha        DateTime? @default(now()) @db.Timestamptz(6)
  libro        libro     @relation(fields: [libro_id], references: [libro_id], onDelete: NoAction, onUpdate: NoAction)
  usuario      usuario   @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([libro_id])
  @@index([usuario_id])
}

model recurso_educativo {
  recurso_id  Int     @id @default(autoincrement())
  libro_id    Int
  tipo        String  @db.VarChar(50)
  url         String  @db.Text
  descripcion String? @db.Text
  libro       libro   @relation(fields: [libro_id], references: [libro_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([libro_id])
}

// ------------------------------------------------------
// LISTAS DE LECTURA
// ------------------------------------------------------

model lista {
  lista_id       Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(255)
  descripcion    String?
  tipo           String?         @db.VarChar(50)
  fecha_creacion DateTime        @default(now()) @db.Timestamptz(6)
  lista_lectura  lista_lectura[]
  lista_libro    lista_libro[]
}

model lista_lectura {
  lista_id       Int
  docente_id     Int
  descripcion    String?
  nivel          String?   @db.VarChar(50)
  fecha_creacion DateTime? @default(now()) @db.Timestamptz(6)
  usuario        usuario   @relation(fields: [docente_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
  lista          lista     @relation(fields: [lista_id], references: [lista_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([lista_id, docente_id])
}

model lista_libro {
  lista_id Int
  libro_id Int
  libro    libro @relation(fields: [libro_id], references: [libro_id], onDelete: Cascade, onUpdate: NoAction)
  lista    lista @relation(fields: [lista_id], references: [lista_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([lista_id, libro_id])
}

// ------------------------------------------------------
// REQ-11: FOROS APL Y RADIO SÁBATO
// ------------------------------------------------------

model radio_episodio {
  episodio_id   Int       @id @default(autoincrement())
  titulo        String    @db.VarChar(255)
  descripcion   String?   @db.Text
  audio_url     String    @db.Text
  programa      String?   @db.VarChar(100)
  fecha_emision DateTime? @default(now()) @db.Timestamptz(6)

  foro foro[]
}

model foro {
  foro_id        Int       @id @default(autoincrement())
  titulo         String    @db.VarChar(255)
  descripcion    String?
  creador_id     Int?
  cafe_id        Int?
  episodio_id    Int? // Vinculación opcional con Radio Sábato
  es_apl         Boolean   @default(false)
  fecha_creacion DateTime? @default(now()) @db.Timestamptz(6)

  comentario_foro comentario_foro[]
  usuario         usuario?          @relation(fields: [creador_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
  cafe_literario  cafe_literario?   @relation(fields: [cafe_id], references: [cafe_id], onDelete: Cascade, onUpdate: NoAction)
  radio_episodio  radio_episodio?   @relation(fields: [episodio_id], references: [episodio_id], onDelete: SetNull)

  @@index([episodio_id])
}

model comentario_foro {
  comentario_id Int       @id @default(autoincrement())
  foro_id       Int
  usuario_id    Int
  contenido     String
  fecha         DateTime? @default(now()) @db.Timestamptz(6)
  foro          foro      @relation(fields: [foro_id], references: [foro_id], onDelete: Cascade, onUpdate: NoAction)
  usuario       usuario   @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([foro_id])
  @@index([usuario_id])
}

// ------------------------------------------------------
// CLUB DE LECTURA, MEDALLAS Y EXPORTACIÓN
// ------------------------------------------------------

model club_lectura {
  club_id              Int                    @id @default(autoincrement())
  nombre               String                 @db.VarChar(255)
  descripcion          String?
  fecha_inicio         DateTime?              @db.Date
  fecha_fin            DateTime?              @db.Date
  orador               String?                @db.VarChar(255)
  usuario_club_lectura usuario_club_lectura[]
}

model usuario_club_lectura {
  usuario_id    Int
  club_id       Int
  fecha_ingreso DateTime?    @default(now()) @db.Timestamptz(6)
  rol_en_club   String?      @db.VarChar(50)
  club_lectura  club_lectura @relation(fields: [club_id], references: [club_id], onDelete: NoAction, onUpdate: NoAction)
  usuario       usuario      @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([usuario_id, club_id])
}

model medalla {
  medalla_id      Int               @id @default(autoincrement())
  nombre          String            @unique @db.VarChar(100)
  descripcion     String?
  tipo_accion     String?           @db.VarChar(50)
  fecha_creacion  DateTime?         @default(now()) @db.Timestamptz(6)
  usuario_medalla usuario_medalla[]
}

model usuario_medalla {
  usuario_id     Int
  medalla_id     Int
  fecha_obtenida DateTime? @default(now()) @db.Timestamptz(6)
  medalla        medalla   @relation(fields: [medalla_id], references: [medalla_id], onDelete: NoAction, onUpdate: NoAction)
  usuario        usuario   @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([usuario_id, medalla_id])
}

model exportacion {
  exportacion_id                Int       @id @default(autoincrement())
  fecha_exportacion             DateTime? @default(now()) @db.Timestamptz(6)
  usuario_admin_id              Int?
  cantidad_opiniones_exportadas Int?
  formato_archivo               String?   @db.VarChar(50)
  estado                        String?   @db.VarChar(50)
  usuario                       usuario?  @relation(fields: [usuario_admin_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
}

// ------------------------------------------------------
// CAFÉ LITERARIO
// ------------------------------------------------------

model cafe_literario {
  cafe_id        Int               @id @default(autoincrement())
  titulo         String            @db.VarChar(255)
  descripcion    String?           @db.Text
  libro_id       Int?
  docente_id     Int?
  fecha_evento   DateTime          @db.Timestamptz(6)
  lugar          String?           @default("Biblioteca Ernesto Sábato") @db.VarChar(255)
  estado         String?           @default("programado") @db.VarChar(50)
  fecha_creacion DateTime?         @default(now()) @db.Timestamptz(6)
  libro          libro?            @relation(fields: [libro_id], references: [libro_id], onDelete: SetNull, onUpdate: NoAction)
  usuario        usuario?          @relation(fields: [docente_id], references: [usuario_id], onDelete: SetNull, onUpdate: NoAction)
  asistencia_cafe asistencia_cafe[]
  voto_cafe       voto_cafe[]
  foro            foro[]

  @@index([libro_id])
  @@index([docente_id])
}

model asistencia_cafe {
  asistencia_id  Int             @id @default(autoincrement())
  cafe_id        Int
  usuario_id     Int
  estado         String?         @default("confirmado") @db.VarChar(50)
  fecha_registro DateTime?       @default(now()) @db.Timestamptz(6)
  cafe_literario cafe_literario  @relation(fields: [cafe_id], references: [cafe_id], onDelete: Cascade, onUpdate: NoAction)
  usuario        usuario         @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cafe_id, usuario_id])
  @@index([usuario_id])
}

model voto_cafe {
  voto_id        Int             @id @default(autoincrement())
  cafe_id        Int
  usuario_id     Int
  voto           Boolean
  fecha_voto     DateTime?       @default(now()) @db.Timestamptz(6)
  cafe_literario cafe_literario  @relation(fields: [cafe_id], references: [cafe_id], onDelete: Cascade, onUpdate: NoAction)
  usuario        usuario         @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cafe_id, usuario_id])
  @@index([usuario_id])
}

// ------------------------------------------------------
// META DE LECTURA
// ------------------------------------------------------

model meta_lectura {
  meta_id         Int       @id @default(autoincrement())
  usuario_id      Int
  periodo_nombre  String    @db.VarChar(100) // Ej: "1º Cuatrimestre 2026", "Meta Anual 2026"
  cantidad_libros Int
  fecha_inicio    DateTime  @db.Date
  fecha_fin       DateTime  @db.Date
  fecha_creacion  DateTime? @default(now()) @db.Timestamptz(6)

  usuario usuario @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id])
}

model configuracion_sistema {
  clave       String   @id @db.VarChar(100)
  valor       String   @db.Text
  descripcion String?  @db.Text
  actualizado DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model incidencia_moderacion {
  incidencia_id       Int       @id @default(autoincrement())
  usuario_id          Int?
  contexto            String    @db.VarChar(50)
  contenido_bloqueado String    @db.Text
  motivo              String    @db.Text
  categoria           String?   @db.VarChar(100)
  estado              String    @default("pendiente") @db.VarChar(20)
  revisado_por        Int?
  fecha_revision      DateTime? @db.Timestamptz(6)
  fecha               DateTime  @default(now()) @db.Timestamptz(6)
  usuario             usuario?  @relation(fields: [usuario_id], references: [usuario_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([usuario_id])
  @@index([fecha])
}

// ------------------------------------------------------
// SAB 031 CURSOS, MATERIAS Y ASIGNACIONES 
// ------------------------------------------------------

model materia {
  materia_id Int     @id @default(autoincrement())
  nombre     String  @unique @db.VarChar(100)
  curso      curso[]
}

model curso {
  curso_id      Int             @id @default(autoincrement())
  anio          Int
  division      String          @db.VarChar(5)
  anio_lectivo  Int
  materia_id    Int
  materia       materia         @relation(fields: [materia_id], references: [materia_id], onDelete: NoAction, onUpdate: NoAction)
  curso_docente curso_docente[]
  curso_libro   curso_libro[]
  inscripcion   inscripcion[]

  @@unique([anio, division, anio_lectivo])
  @@index([materia_id])
}

model curso_docente {
  curso_id   Int
  usuario_id Int
  curso      curso   @relation(fields: [curso_id], references: [curso_id], onDelete: NoAction, onUpdate: NoAction)
  usuario    usuario @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([curso_id, usuario_id])
  @@index([usuario_id])
}

model curso_libro {
  curso_id Int
  libro_id Int
  puntaje  Int
  curso    curso @relation(fields: [curso_id], references: [curso_id], onDelete: NoAction, onUpdate: NoAction)
  libro    libro @relation(fields: [libro_id], references: [libro_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([curso_id, libro_id])
  @@index([libro_id])
}

model inscripcion {
  inscripcion_id    Int      @id @default(autoincrement())
  usuario_id        Int
  curso_id          Int
  anio_lectivo      Int
  fecha_inscripcion DateTime @default(now()) @db.Timestamptz(6)
  usuario           usuario  @relation(fields: [usuario_id], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction)
  curso             curso    @relation(fields: [curso_id], references: [curso_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([usuario_id, anio_lectivo])
  @@index([curso_id])
  @@index([usuario_id])
}
