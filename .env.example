# Configuración de la API REST
PORT=3001
JWT_SECRET="tu_clave_secreta_jwt_aqui"

# Conexión a PostgreSQL en Supabase
# Ejemplo con Connection Pooler (Transacción / Puerto 6543):
# DATABASE_URL="postgresql://postgres.[TU_PROYECTO_REF]:[TU_CONTRASEÑA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Ejemplo con Conexión Directa (Puerto 5432):
DATABASE_URL="postgresql://postgres:[TU_CONTRASEÑA]@db.[TU_PROYECTO_REF].supabase.co:5432/postgres"

# Clave inicial para creación de usuario administrador (opcional)
ADMIN_INITIAL_KEY="ADMIN1234"

# Orígenes extra permitidos por CORS, separados por coma (opcional).
# Ej.: la URL de Netlify de un deploy de prueba.
# CORS_ORIGINS="https://mi-sitio.netlify.app,https://otro-sitio.netlify.app"

JWT_EXPIRES_IN=1d

# SAB-67: PDFs de material de lectura en Supabase Storage (bucket privado).
# SUPABASE_SECRET_KEY es la "Secret key" (sb_secret_...) o la service_role del proyecto:
# tiene acceso total, va solo en el back y nunca se commitea ni se comparte por chat.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PDF_BUCKET=material-lectura
